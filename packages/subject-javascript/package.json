{
  "name": "@lg/subject-javascript",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "default": "./dist/runner/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --force",
    "lint": "eslint src tests",
    "content:dump": "tsx ../../packages/subject-kit/src/cli.ts dump --subject javascript",
    "content:prompt": "tsx ../../packages/subject-kit/src/cli.ts prompt --subject javascript",
    "content:add": "tsx ../../packages/subject-kit/src/cli.ts add --subject javascript",
    "content:template": "tsx ../../packages/subject-kit/src/cli.ts template --subject javascript"
  },
  "dependencies": {
    "@lg/core": "*",
    "@lg/subject-kit": "*"
  },
  "devDependencies": {
    "@lg/content-pipeline": "*",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.4"
  }
}
