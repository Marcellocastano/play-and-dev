{
  "name": "play-and-dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"npm run dev -w @lg/web\" \"npm run dev -w @lg/server\"",
    "dev:web": "npm run dev -w @lg/web",
    "dev:server": "npm run dev -w @lg/server",
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "content:add": "npm run content:add -w @lg/subject-javascript --",
    "content": "tsx packages/subject-kit/src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "22.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "concurrently": "^10.0.6",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.1"
  }
}
